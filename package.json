  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env.local apps/api/src/server.js",
    "start": "node --env-file=.env.local apps/api/src/server.js",
    "dev:demo": "node apps/api/src/server.js",
