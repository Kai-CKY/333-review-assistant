# Copy to .env.local and configure Web login. Never put plaintext passwords here.
# Generate a hash interactively: node scripts/hash-web-password.mjs
# WEB_USERS accepts 1-2 name:hash entries separated by commas. Wrap the entire
# value in single quotes in .env.local to preserve '$' in Docker Compose.
WEB_USERS=
# Comma-separated Web account names with read-only access to Yangyang's data.
# Set this to your administrator login name; other Web accounts are the learner.
WEB_ADMIN_USERS=
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
WEB_SESSION_SECRET=
WEB_SESSION_TTL_SECONDS=604800
# false for current HTTP IP access; true after enabling HTTPS.
COOKIE_SECURE=false
# Enable only behind Nginx that OVERWRITES X-Real-IP and forwards Host.
TRUST_PROXY=false
# Optional explicit knowledge scopes. Default: configured main group and learner
# private main conversations. Other groups/topics are not shared automatically.
KNOWLEDGE_SCOPE_KEYS=

# `npm run feishu:create` writes Feishu credentials after QR authorization.
FEISHU_ENABLED=false
# Cloud single-instance deployments: point this at a persistent volume.
# DATA_FILE=/data/review-assistant.json
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TESTER_OPEN_ID=
# Recommended explicit bindings. /身份 in DM prints the sender's own open_id.
# Learner fallback for existing installations: TESTER_OPEN_ID, then GROUP_TARGET_OPEN_ID.
FEISHU_LEARNER_OPEN_ID=
FEISHU_OWNER_OPEN_ID=
# allowlist: only bound learner/admin; open: app-visible users, unbound cannot read study data.
# disabled: no private conversations. Admission never confers a role.
FEISHU_DM_MODE=allowlist

# 仅用于一次性的群测：必须精确指定一个群和羊羊的 ou_ open_id。
# 机器人确认羊羊加入后仅发送一次“今日学习情况”提问；不开放通用群聊处理。
FEISHU_GROUP_TEST_ENABLED=false
FEISHU_TEST_GROUP_ID=
FEISHU_GROUP_TARGET_OPEN_ID=
FEISHU_GROUP_CHAT_ENABLED=false

# Ark / 豆包模型：这些值只放在 Git 忽略的 .env.local，绝不提交。
# ARK_MODEL_ID 既可填公共模型 ID，也可填方舟创建的专用 ep-... 推理接入点。
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL_ID=doubao-seed-2-1-turbo-260628
# Select a model enabled in YOUR Ark account; ModelNotOpen/404 means unavailable.
# Existing cloud deployment uses doubao-seed-2-1-pro-260915. Preserve its override.
# 交互型学习助手默认关闭模型深度思考以降低延迟；复杂推理时才改为 enabled。
ARK_THINKING_TYPE=disabled
# 仅在已确认开通方式与计费后自行设为 fast；留空使用默认服务档。
ARK_SERVICE_TIER=
ARK_TIMEOUT_MS=45000
# 图片知识点核验通过 Responses API 的 web_search 工具进行。
# 需在方舟控制台开通联网搜索；未开通时只生成待核验草稿，禁止确认入库。
# 可选：使用另一个支持联网搜索的模型；不填沿用 ARK_MODEL_ID。
ARK_SEARCH_MODEL_ID=

# PDF parsing is offline only; the application ignores old PDF_PARSER_URL settings.
# 羊羊确认权限：优先 FEISHU_LEARNER_OPEN_ID，再 TESTER_OPEN_ID、GROUP_TARGET_OPEN_ID。
# 管理员仅查看学习数据；昵称、自我介绍、open 私聊准入都不授予羊羊权限。
